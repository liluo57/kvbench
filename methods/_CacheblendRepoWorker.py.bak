"""CacheBlend method — *calls* the original CacheBlend source, not a copy.

The CacheBlend algorithm (collect phase, check phase, important-token
recomputation) is implemented in the original authors' patched vLLM
(``~/cache-blend/CacheBlend/vllm_blend``, v0.4.1) and driven by their example
scripts. This method does not reimplement any of it: it launches a persistent
worker subprocess under the original repo's own venv
(``_CacheblendWorker.py``) and orchestrates it over JSON-lines, exactly the
way ``example/blend_niah.py`` drives the model hooks.

Per case the engine calls, in order:

    Prepare(chunks)  -> worker collects the shared context KV once (collect or
                        collect_chunks; an empty list means nothing to cache)
    Run(prompt)      -> SplitReuseParts strips the cached context off ``prompt``:
                          * suffix found   -> worker fuses the fresh suffix KV
                          * no suffix     -> worker generates the whole prompt
                              (``full`` op: no reuse, e.g. NIAHShuffleTask)
    Reset()          -> cached KVs are dropped

The full prompt token sequence is ``context + suffix`` (NIAH), or, for a
chunked context (cacheblend's musique-style knowledge base), the chunks are
each collected in isolation and concatenated before the suffix is fused.

The constructor takes the task's available GPUs (``gpu_ids``, equivalent to
``CUDA_VISIBLE_DEVICES``) and the re-computation ratio ``recomp_ratio``:
0.0 is lossless for a contiguous cached prefix; >0 repairs cross-chunk
attention in a chunk-isolated knowledge base (musique needs ~0.16).
"""

import json
import os
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import Any, Dict, List, Optional, Union

from core.Config import Get as GetConfig
from core.Config import ModelPath as DefaultModelPath
from core.Method import Method
from core.Result import NumOutputTokensKey, Result, TotalTimeKey, TtftKey

from helpers.Prompt import SplitReuseParts

#: Default original CacheBlend repo + its venv python, overridden by the
#: ``CacheBlendRepo`` / ``CacheBlendWorkerPython`` keys in configs/datasets.yaml.
DefaultRepoRoot = Path.home() / "cache-blend" / "CacheBlend"
DefaultWorkerPython = DefaultRepoRoot / ".venv" / "bin" / "python"


class CacheBlendMethod(Method):
    name = "cacheblend"

    def __init__(
        self,
        gpuIds: Union[str, List[int]] = "0",
        modelPath: Optional[str] = None,
        *,
        numLayers: int = 28,
        maxNewTokens: int = 64,
        maxModelLen: int = 98304,
        gpuMemoryUtilization: float = 0.7,
        recompRatio: float = 0.0,
        dtype: str = "bfloat16",
        enforceEager: bool = True,
        repoRoot: Optional[Union[str, Path]] = None,
        workerPython: Optional[Union[str, Path]] = None,
        startTimeout: float = 1800.0,
    ):
        self.gpuIds = gpuIds
        self.modelPath = modelPath or DefaultModelPath()
        self.numLayers = numLayers
        self.maxNewTokens = maxNewTokens
        self.maxModelLen = maxModelLen
        self.gpuMemoryUtilization = gpuMemoryUtilization
        self.recompRatio = recompRatio
        self.dtype = dtype
        self.enforceEager = enforceEager
        # Repo + venv come from configs/datasets.yaml unless passed explicitly.
        self.repoRoot = Path(repoRoot) if repoRoot else Path(
            str(GetConfig("CacheBlendRepo", DefaultRepoRoot))
        )
        self.workerPython = Path(workerPython) if workerPython else Path(
            str(GetConfig("CacheBlendWorkerPython", DefaultWorkerPython))
        )
        self.startTimeout = startTimeout

        if not self.workerPython.exists():
            raise FileNotFoundError(
                f"CacheBlend worker python not found: {self.workerPython} "
                f"(the original repo's venv; pass worker_python= explicitly)"
            )

        self._proc: Optional[subprocess.Popen] = None
        self._drainThread = None
        self._prepare: List[str] = []
        self._startWorker()

    # ------------------------------------------------------------- worker io
    def _drainStderr(self) -> None:
        """Forward the worker's stderr (vLLM logs) to our own stderr."""
        assert self._proc is not None and self._proc.stderr is not None
        try:
            for line in self._proc.stderr:
                sys.stderr.write(f"[cacheblend-worker] {line}")
                sys.stderr.flush()
        except Exception:  # noqa: BLE001 - pipe closed on shutdown
            pass

    def _startWorker(self) -> None:
        workerScript = Path(__file__).with_name("_CacheblendWorker.py")
        env = dict(os.environ)
        # The framework no longer sets LD_PRELOAD, but a login shell may still
        # export one (e.g. the historical cudart workaround); drop it so it
        # never leaks into the worker and changes its dynamic linking.
        env.pop("LD_PRELOAD", None)
        env["CUDA_VISIBLE_DEVICES"] = (
            str(self.gpuIds)
            if isinstance(self.gpuIds, str)
            else ",".join(str(g) for g in self.gpuIds)
        )
        self._proc = subprocess.Popen(
            [
                str(self.workerPython),
                str(workerScript),
                "--repo_root", str(self.repoRoot),
                "--model", self.modelPath,
                "--num_layers", str(self.numLayers),
                "--max_new_tokens", str(self.maxNewTokens),
                "--max_model_len", str(self.maxModelLen),
                "--gpu_memory_utilization", str(self.gpuMemoryUtilization),
                "--recomp_ratio", str(self.recompRatio),
                "--dtype", self.dtype,
            ]
            + (["--enforce_eager"] if self.enforceEager else []),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=env,
            bufsize=1,
        )
        # The worker's vLLM logs a lot to stderr (progress bars, INFO). The pipe
        # must be drained or it fills (64KB) and the worker deadlocks on write.
        self._drainThread = threading.Thread(
            target=self._drainStderr, daemon=True, name="cb-worker-stderr"
        )
        self._drainThread.start()
        # Wait until the worker has loaded the model and is ready to serve.
        ready = False
        deadline = time.time() + self.startTimeout
        while time.time() < deadline:
            line = self._proc.stdout.readline()
            if not line:
                if self._proc.poll() is not None:
                    err = self._proc.stderr.read() or "(no stderr)"
                    raise RuntimeError(
                        f"cacheblend worker exited during startup: {err}"
                    )
                continue
            line = line.strip()
            if line.startswith("[cacheblend-worker] ready"):
                ready = True
                break
            # forward any other startup logging
            print(line, flush=True)
        if not ready:
            self._proc.kill()
            raise TimeoutError("cacheblend worker did not become ready")

    def _Request(self, payload: Dict[str, Any], timeout: float = 3600.0) -> Dict[str, Any]:
        self._proc.stdin.write(json.dumps(payload) + "\n")
        self._proc.stdin.flush()
        line = self._proc.stdout.readline()
        if not line:
            err = (self._proc.stderr.read() or "")[-2000:]
            raise RuntimeError(f"cacheblend worker closed stdout: {err}")
        resp = json.loads(line)
        if not resp.get("ok"):
            raise RuntimeError(f"cacheblend worker error: {resp.get('error')}")
        return resp

    # ---------------------------------------------------------------- Method
    def Prepare(self, data: List[str]) -> None:
        self._prepare = list(data or [])
        if not self._prepare:
            return  # nothing to warm up; Run falls back to the ``full`` op
        if len(self._prepare) == 1:
            self._Request({"op": "collect", "text": self._prepare[0]})
        else:
            self._Request({"op": "collect_chunks", "chunks": self._prepare})

    def Run(self, data: str) -> Result:
        _, suffix = SplitReuseParts(self._prepare, data)
        if suffix is None:
            # No reusable prefix (empty warm-up or shuffled order): generate the
            # whole prompt from scratch on the worker.
            resp = self._Request({"op": "full", "text": data})
            reuseRatio = 0.0
        else:
            resp = self._Request({"op": "fuse", "suffix": suffix})
            reuseRatio = 1.0 - self.recompRatio
        return Result(
            output=resp["text"],
            performance={
                TtftKey: resp["ttft"],
                NumOutputTokensKey: resp["num_tokens"],
                TotalTimeKey: resp.get("total_time", resp["ttft"]),
            },
            metadata={
                "reuse_ratio": reuseRatio,
                "recomp_ratio": self.recompRatio,
                "n_input": resp.get("n_input"),
            },
        )

    def Reset(self) -> None:
        try:
            self._Request({"op": "reset"})
        except (BrokenPipeError, RuntimeError):
            self._restartWorker()

    def Close(self) -> None:
        if self._proc is not None:
            try:
                self._proc.stdin.write(json.dumps({"op": "close"}) + "\n")
                self._proc.stdin.flush()
                self._proc.wait(timeout=30)
            except Exception:  # noqa: BLE001
                self._proc.kill()
            self._proc = None

    def _restartWorker(self) -> None:
        self.Close()
        self._startWorker()

    def __del__(self):
        try:
            self.Close()
        except Exception:  # noqa: BLE001
            pass
